<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Header bar with title and current status -->
    <LinearLayout
        android:id="@+id/widget_daily_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_compass"
            android:contentDescription="Axis" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="DAY EVALUATION"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_today_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to log"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- 5 Evaluation Circles (Red, Orange, Yellow, Green, Gold) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Red Circle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_color_red"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle_red"
                android:contentDescription="Rate Red" />
        </FrameLayout>

        <!-- Orange Circle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_color_orange"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle_orange"
                android:contentDescription="Rate Orange" />
        </FrameLayout>

        <!-- Yellow Circle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_color_yellow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle_yellow"
                android:contentDescription="Rate Yellow" />
        </FrameLayout>

        <!-- Green Circle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_color_green"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle_green"
                android:contentDescription="Rate Green" />
        </FrameLayout>

        <!-- Gold Circle -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_color_gold"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_circle_gold"
                android:contentDescription="Rate Gold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Subtitle / Long-press hint -->
    <TextView
        android:id="@+id/tv_daily_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap rating • Hold to write review"
        android:textSize="9sp"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_text_secondary"
        android:gravity="center" />
</LinearLayout>
