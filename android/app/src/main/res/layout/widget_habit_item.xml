<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_item_root"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Checkbox ImageButton -->
    <ImageButton
        android:id="@+id/btn_habit_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@null"
        android:src="@drawable/ic_widget_box"
        android:scaleType="fitCenter"
        android:contentDescription="Toggle habit" />

    <!-- Anchor Habit Flame Icon (Visible only if isAnchor is true) -->
    <ImageView
        android:id="@+id/iv_anchor_flame"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_widget_flame"
        android:visibility="gone"
        android:contentDescription="Anchor habit" />

    <!-- Habit Title Text -->
    <TextView
        android:id="@+id/tv_habit_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical"
        android:text="Morning Workout"
        android:textSize="11.5sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
