# ====================================================================
# Axis Environment Variables Template
# Copy this file to .env (or .env.local) and populate with your own values.
# NEVER commit your actual .env file or real secrets to git!
# ====================================================================

# AI Studio runtime
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="https://your-app-domain.com"

# Firebase Client Configuration (Web / Cross-Platform)
# These replace hardcoded values from firebase-applet-config.json
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
